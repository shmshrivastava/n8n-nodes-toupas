{
	"name": "n8n-nodes-toupas",
	"version": "0.1.0",
	"description": "Put websites and apps with saved data live at a link anyone can open, from n8n workflows.",
	"license": "MIT",
	"homepage": "https://toupas.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"toupas",
		"website",
		"publish",
		"html",
		"app"
	],
	"author": {
		"name": "Shivam Shrivastava",
		"email": "shivam270295@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shmshrivastava/n8n-nodes-toupas.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ToupasApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Toupas/Toupas.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
